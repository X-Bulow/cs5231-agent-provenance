(version 1)
(allow default)
(deny file-write* (require-not (require-any (subpath "__WORKSPACE__") (subpath "__RUNTIME__") (subpath "__TEMP__") (literal "/dev/null") (literal "/dev/tty"))))
(deny file-read-data (require-all (subpath "__HOME__") (require-not (require-any (subpath "__WORKSPACE__") (subpath "__RUNTIME__") __ANCESTORS__))))
